APP_ENV=development
RUST_LOG=vpn_api=debug,info
API_BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://vpn_bot:replace-me@postgres:5432/vpn_bot
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST_PORT=5432
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-value
TELEGRAM_TRANSPORT=polling
# Required only for TELEGRAM_TRANSPORT=webhook. Point to the public reverse-proxy route.
TELEGRAM_WEBHOOK_PUBLIC_URL=https://replace-me.invalid/telegram/webhook
TELEGRAM_WEBHOOK_BIND_ADDR=0.0.0.0:8083
TELEGRAM_BOT_USERNAME=replace-me
SUPPORT_URL=https://t.me/replace-me
MINI_APP_PUBLIC_URL=http://localhost:8081
# Public origin for protected subscription gateway links. Defaults to MINI_APP_PUBLIC_URL when omitted.
SUBSCRIPTION_PUBLIC_URL=http://localhost:8081
BOOTSTRAP_ADMIN_TELEGRAM_IDS=123456789
# Comma-separated exact browser origins allowed to call the API cross-origin.
MINI_APP_ALLOWED_ORIGINS=http://localhost:5173
APPLICATION_ENCRYPTION_KEY=base64-encoded-32-byte-key
CRYPTO_PAY_TOKEN=replace-me
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot/api
ANORE_API_KEY=replace-me
ANORE_SIGNING_SECRET=replace-me
ANORE_BASE_URL=https://api.anore.cc/v1
REMNAWAVE_BASE_URL=https://replace-me.invalid
REMNAWAVE_API_TOKEN=replace-me
