# Docker images are generated by setup.sh. Pin SHA tags for manual releases or
# keep latest when automatic updates are enabled.
VPN_API_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-vpn-api:latest
VPN_TELEGRAM_BOT_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-vpn-telegram-bot:latest
VPN_BILLING_WORKER_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-vpn-billing-worker:latest
VPN_PROVISIONING_WORKER_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-vpn-provisioning-worker:latest
VPN_NOTIFICATION_WORKER_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-vpn-notification-worker:latest
VPN_ADMIN_WEB_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-admin-web:latest
VPN_MINI_APP_WEB_IMAGE=ghcr.io/zeragorn-ru/vpn-bot-v2-mini-app-web:latest

POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://vpn_bot:replace-with-a-strong-password@postgres:5432/vpn_bot
REDIS_URL=redis://redis:6379
# Root key for encrypted database secrets. Keep it outside the database and backups.
APPLICATION_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Every container publishes only to loopback. Configure host nginx and TLS separately.
API_HOST_PORT=18080
MINI_APP_WEB_HOST_PORT=18081
ADMIN_WEB_HOST_PORT=18082
TELEGRAM_WEBHOOK_HOST_PORT=18083

# These product and integration variables are required by the current release.
# They will move to encrypted PostgreSQL settings during the configuration migration.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_TRANSPORT=webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_WEBHOOK_PUBLIC_URL=https://mini.example.com/telegram/webhook
TELEGRAM_WEBHOOK_BIND_ADDR=0.0.0.0:8083
SUPPORT_URL=https://t.me/replace-me
MINI_APP_PUBLIC_URL=https://mini.example.com
SUBSCRIPTION_PUBLIC_URL=https://mini.example.com
MINI_APP_ALLOWED_ORIGINS=https://mini.example.com,https://admin.example.com
BOOTSTRAP_ADMIN_TELEGRAM_IDS=123456789
CRYPTO_PAY_TOKEN=replace-me
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot/api
ANORE_API_KEY=replace-me
ANORE_SIGNING_SECRET=replace-me
ANORE_BASE_URL=https://api.anore.cc/v1
REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=replace-me
REMNAWAVE_INTERNAL_SQUAD_UUIDS=
REMNAWAVE_EXTERNAL_SQUAD_UUID=
REMNAWAVE_TRAFFIC_LIMIT_STRATEGY=NO_RESET
REMNAWAVE_USER_TAG=PAID
REMNAWAVE_USERNAME_PREFIX=vpn
